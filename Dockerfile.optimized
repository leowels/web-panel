# Оптимизированный Dockerfile для быстрого деплоя

# ============================================
# Stage 1: Frontend Build (с кэшированием)
# ============================================
FROM node:18-alpine AS frontend-builder

WORKDIR /app

# Копируем только package files для кэширования слоя
COPY package.json package-lock.json* ./

# Устанавливаем зависимости (этот слой будет кэшироваться)
RUN npm ci --silent

# Копируем исходники
COPY . .

# Сборка (быстрая в Alpine)
ENV NEXT_PUBLIC_API_URL=
ENV BACKEND_URL=http://127.0.0.1:8000
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# ============================================
# Stage 2: Python Dependencies (оптимизированно)
# ============================================
FROM python:3.11-slim AS backend-builder

WORKDIR /app

# Устанавливаем только необходимые системные пакеты
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Копируем requirements отдельно для кэширования
COPY backend/requirements.txt ./
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ============================================
# Stage 3: Минимальный Production Image
# ============================================
FROM python:3.11-slim

WORKDIR /app

# Минимальные runtime зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

# Копируем Python пакеты
COPY --from=backend-builder /opt/venv /opt/venv

# Копируем Backend
COPY backend/ ./backend/

# Копируем Frontend build
COPY --from=frontend-builder /app/public ./public
COPY --from=frontend-builder /app/.next/standalone ./
COPY --from=frontend-builder /app/.next/static ./.next/static

# Entrypoint
COPY docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Пользователь
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Переменные
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV BACKEND_URL=http://127.0.0.1:8000
ENV NEXT_PUBLIC_API_URL=
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:/home/appuser/.local/bin:$PATH
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

EXPOSE 3000

# Быстрый health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
    CMD curl -f http://localhost:${FRONTEND_PORT:-${PORT:-3000}}/api/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]


